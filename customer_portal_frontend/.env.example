# Frontend environment configuration for Unified Customer Portal

# Preferred: Full API base including /api/v1 and protocol.
# For local dev with the provided backend:
# If your environment serves over HTTPS, ensure you use https and correct host.
REACT_APP_API_BASE=https://vscode-internal-15894-beta.beta01.cloud.kavia.ai:3001/api/v1

# Optional legacy base (not needed if REACT_APP_API_BASE is set)
# REACT_APP_BACKEND_URL=https://vscode-internal-15894-beta.beta01.cloud.kavia.ai:3001/api/v1

# Healthcheck path:
# - If relative, it will be appended to REACT_APP_API_BASE.
# - You can also set an absolute full URL.
REACT_APP_HEALTHCHECK_PATH=/health

# UI origin (informational; backend CORS should allow this)
REACT_APP_FRONTEND_URL=https://vscode-internal-15894-beta.beta01.cloud.kavia.ai:3000

# Optional WS base (not used yet)
# REACT_APP_WS_URL=wss://vscode-internal-15894-beta.beta01.cloud.kavia.ai:3001

REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS={"chatbot":false,"liveChat":false,"forums":false}
REACT_APP_EXPERIMENTS_ENABLED=false
