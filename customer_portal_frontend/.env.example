# Frontend environment variables

# PUBLIC_INTERFACE
# REACT_APP_API_BASE: Absolute base URL for backend API including protocol, host, port, and versioned base path.
# Example (local): http://localhost:3001/api/v1
# Example (cloud over TLS): https://vscode-internal-12703-beta.beta01.cloud.kavia.ai:3001/api/v1
REACT_APP_API_BASE=http://localhost:3001/api/v1

# Optional legacy fallback if REACT_APP_API_BASE is not set
REACT_APP_BACKEND_URL=

# PUBLIC_INTERFACE
# Health check path. If absolute (starts with http), it will be used as-is.
# Otherwise it is appended to REACT_APP_API_BASE. Default is /health.
REACT_APP_HEALTHCHECK_PATH=/health

# PUBLIC_INTERFACE
# Frontend base URL (origin) used for configuring backend CORS allowlist if needed.
# Example: http://localhost:3000
REACT_APP_FRONTEND_URL=http://localhost:3000

# Misc flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
