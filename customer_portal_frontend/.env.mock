# Sample environment for running the frontend fully in mock mode (no backend calls)
REACT_APP_USE_MOCKS=true

# Optional: if you later want to test real backend, set this to your API base and flip REACT_APP_USE_MOCKS=false
# REACT_APP_API_BASE=http://localhost:3001/api/v1

# Optional health path when using real backend (ignored in mock mode)
# REACT_APP_HEALTHCHECK_PATH=/health
