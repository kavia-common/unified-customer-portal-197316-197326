# Standalone (mock) defaults
REACT_APP_USE_MOCKS=true

# Suppress all UI-visible errors (toasts/banners/messages). Components will show neutral placeholders.
REACT_APP_SUPPRESS_ERRORS=true

# Optional base/health if switching to backend later (ignored while mocks are ON)
# REACT_APP_API_BASE=http://localhost:3001/api/v1
# REACT_APP_HEALTHCHECK_PATH=/health
