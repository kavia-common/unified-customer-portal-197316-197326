# Standalone mock mode for the frontend (no backend required)
REACT_APP_USE_MOCKS=true

# When mocks are enabled, backend URL variables below are ignored by the app:
# REACT_APP_API_BASE=
# REACT_APP_BACKEND_URL=
# Optional health path is ignored in mock mode as well
# REACT_APP_HEALTHCHECK_PATH=/health

# Standard React variables (optional)
REACT_APP_NODE_ENV=development
REACT_APP_PORT=3000
REACT_APP_ENABLE_SOURCE_MAPS=true
